# LOCAL DEVELOPMENT ONLY. Never commit the real .env file.
DBPULSE_POSTGRES_PASSWORD=dbpulse_dev_password_change_me

# Local MSSQL target (set enabled=true only after the monitoring login works)
DBPULSE_MSSQL_ENABLED=false
DBPULSE_MSSQL_HOST=host.docker.internal
DBPULSE_MSSQL_PORT=1433
DBPULSE_MSSQL_DATABASE=DBPulseLab
DBPULSE_MSSQL_USERNAME=dbpulse_monitor
DBPULSE_MSSQL_PASSWORD=replace-with-real-password

# Only for local SQL Server with a self-signed certificate.
# Do not set true in production; install a trusted cert instead.
DBPULSE_MSSQL_TRUST_SERVER_CERTIFICATE=true

# Phase 14 Windows local-web prototype (requires backend --build).
# Default false: do not expose the unauthenticated local connection form on a LAN.
DBPULSE_LOCAL_TARGETS_ENABLED=false
# Exact hostnames/IPs permitted for temporary read-only connection testing.
# Add explicitly authorized remote DB hostnames here if necessary.
DBPULSE_LOCAL_ALLOWED_DB_HOSTS=host.docker.internal,localhost,127.0.0.1

# Optional DEV-ONLY lab certificate bypass. Never use for remote/production.
# Allowed only with an explicit UI checkbox and local host.docker.internal/localhost/127.0.0.1.
DBPULSE_LOCAL_TRUST_SELF_SIGNED=false
